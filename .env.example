# Optional: vorbelegte Zugangsdaten fuer die Login-Maske (nur lokal!).
# Ohne diese Werte gibst du E-Mail/Passwort einfach im Browser ein.
KB_EMAIL=
KB_PASSWORD=

# Beliebiger, langer Zufallsstring - verschluesselt das Session-Cookie.
SESSION_SECRET=bitte-aendern-irgendein-langer-zufallsstring

# Ligaregeln fuer die Budget-Herleitung auf /liga (Betraege in Euro).
# Vorgabe: 100 Mio zugeteilter Startkader, 50 Mio Startbudget. Nur aendern,
# wenn deine Liga anders gestartet ist. Achtung: die Herleitung setzt voraus,
# dass ohne Boni gespielt wird.
KB_START_TEAM_VALUE=100000000
KB_START_BUDGET=50000000

# --------------------------------------------------------- Schnappschuesse

# Geheimnis fuer den naechtlichen Cron-Aufruf auf POST /api/snapshot.
# Ohne diesen Wert nimmt die Route nur angemeldete Browser an.
SNAPSHOT_SECRET=

# Welche Liga der unbeaufsichtigte Lauf speichert. Ohne Angabe nimmt er die
# erste Liga, die Kickbase zurueckgibt - bei mehreren Ligen besser setzen.
KB_LEAGUE_ID=

# Wohin die SQLite-Datei geschrieben wird. Vorgabe: ./data/kaderzentrale.db
KB_DB_PATH=

# Beim Serverstart einen Schnappschuss holen, falls der heutige noch fehlt.
KB_SNAPSHOT_ON_START=1

# ---------------------------------------------------------------- Bilder
# KB_IMAGE_BASE=https://kickbase.b-cdn.net
# KB_TEAM_LOGO_TEMPLATE=https://kickbase.b-cdn.net/pool/teamsl/{id}.png
