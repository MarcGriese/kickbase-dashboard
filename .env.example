# Optional: vorbelegte Zugangsdaten fuer die Login-Maske (nur lokal!).
# Ohne diese Werte gibst du E-Mail/Passwort einfach im Browser ein.
KB_EMAIL=
KB_PASSWORD=

# Beliebiger, langer Zufallsstring - verschluesselt das Session-Cookie.
SESSION_SECRET=bitte-aendern-irgendein-langer-zufallsstring

# Ligaregeln fuer die Budget-Herleitung auf /liga (Betraege in Euro).
# Vorgabe: 100 Mio zugeteilter Startkader, 50 Mio Startbudget. Nur aendern,
# wenn deine Liga anders gestartet ist. Achtung: die Herleitung setzt voraus,
# dass ohne Boni gespielt wird.
KB_START_TEAM_VALUE=100000000
KB_START_BUDGET=50000000
